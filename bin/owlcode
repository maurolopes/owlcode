#!/usr/bin/python3 -I
"""owlcode: the one command the owner types for the orchestrator and the agents' user (OWL-54).

    owlcode            print the list of commands
    owlcode COMMAND [ARGUMENT ...]

Each command runs the script that its mise task ran before, through `.workflow/approved_run.py`, so the launcher still
shows what changed in a guarded file since the owner's last yes. This file only maps a command to a script and its
arguments, and runs it from this checkout. Put the checkout's `bin` on the PATH (README.md).

`admin` needs the agents' user name: it takes it from `[service] user` of the installed config, never from the name of
the checkout (OWL-44), and stops when the config has no such key. `admin --project TEAM` makes the agents' user of one
team (OWL-62, design b2: one user for each project): its name is the `agent_user` of that team's table in the config (the
top-level keys for the first team, a `[[product]]` table for each other team), and it passes the team, its repository and
the table's `paseo_port` on to `agent_user.py admin`. A table with no `agent_user`, or one that names `[service] user`, is
refused: the orchestrator's own user never becomes one project's user (its tokens would then reach that repository only).

Standard library only; Python 3.9 (`/usr/bin/python3`) and newer, so it runs where the Mac has only the Command Line Tools.
"""

from __future__ import annotations

import os
import re
import sys
from collections.abc import Callable, Mapping, Sequence
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CONFIG = Path(os.environ.get("OWLCODE_CONFIG", "/usr/local/etc/orchestrator.toml"))
PYTHON = "/usr/bin/python3"
LAUNCHER = ".workflow/approved_run.py"
INSTALL = "orchestrator/deploy/install.py"
AGENT_USER = ".workflow/agent_user.py"
USER_RULE = re.compile(r"[a-z]([a-z0-9-]{0,30}[a-z0-9])?")


class Refused(Exception):
    """A command that cannot run: its text is the owner's message."""


def install_command(name: str) -> Callable[[Sequence[str]], list[str]]:
    """`install.py -- NAME ARGS`; `install` itself takes no name, as the task ran it: `install.py -- ARGS`."""
    def build(args: Sequence[str]) -> list[str]:
        return [PYTHON, "-I", LAUNCHER, INSTALL, "--", *([name] if name else []), *args]
    return build


def agent_command(name: str, sudo: bool = False) -> Callable[[Sequence[str]], list[str]]:
    def build(args: Sequence[str]) -> list[str]:
        return [*(["sudo"] if sudo else []), PYTHON, "-I", LAUNCHER, AGENT_USER, "--", name, *args]
    return build


def service_user(config: Path) -> str:
    """`[service] user` of the orchestrator's config. A small reader: tomllib needs Python 3.11, and this runs on 3.9."""
    try:
        lines = config.read_text().splitlines()
    except OSError as e:
        raise Refused(f"cannot read {config} ({type(e).__name__}): `owlcode admin` takes the agents' user from its [service] user") from None
    section = ""
    for line in lines:
        line = line.split("#", 1)[0].strip()
        header = re.fullmatch(r"\[([^\[\]]+)\]", line)
        if header:
            section = header.group(1).strip()
        elif section == "service":
            found = re.fullmatch(r'user\s*=\s*"([^"]*)"', line)
            if found:
                if not USER_RULE.fullmatch(found.group(1)):
                    raise Refused(f"{config}: [service] user {found.group(1)!r} is not a user name of a lowercase letter, digits and dashes")
                return found.group(1)
    raise Refused(f"{config} has no [service] user: `owlcode admin` does not guess the agents' user from the checkout")


def products(config: Path) -> list[dict[str, object]]:
    """Each product of the config, the first one first: its `team`, `repo`, `agent_user` and `paseo_port`. The first
    product is `[linear] team`, `[github] repo` and the top-level keys; each `[[product]]` table is one more. A small
    reader, as `service_user`: text values in quotes and whole numbers only."""
    try:
        lines = config.read_text().splitlines()
    except OSError as e:
        raise Refused(f"cannot read {config} ({type(e).__name__}): `owlcode admin --project` takes the team's table from it") from None
    first: dict[str, object] = {}
    found = [first]
    section = ""
    wanted = {"": ("agent_user", "paseo_port"), "linear": ("team",), "github": ("repo",),
              "product": ("team", "repo", "agent_user", "paseo_port")}
    for line in lines:
        line = line.split("#", 1)[0].strip()
        if re.fullmatch(r"\[\[\s*product\s*\]\]", line):
            section = "product"
            found.append({})
            continue
        header = re.fullmatch(r"\[([^\[\]]+)\]", line)
        if header or re.fullmatch(r"\[\[[^\[\]]+\]\]", line):
            section = header.group(1).strip() if header else "?"
            continue
        pair = re.fullmatch(r'([a-z_]+)\s*=\s*(?:"([^"]*)"|\'([^\']*)\'|([0-9]+))', line)
        if pair and pair.group(1) in wanted.get(section, ()):
            table = found[-1] if section == "product" else first
            text = pair.group(2) if pair.group(2) is not None else pair.group(3)
            table[pair.group(1)] = text if text is not None else int(pair.group(4))
    return found


def project_args(config: Path, team: str) -> tuple[str, list[str]]:
    """The agents' user of `team` (the `agent_user` of its table) and the arguments that `agent_user.py admin` takes for
    it: the team, its repository, the Paseo port when the table names one, and the orchestrator's user (`[service] user`).
    A table with no `agent_user`, or with `[service] user` there, is refused: the project file in the home of the
    orchestrator's user would limit the service's own tokens to that one repository."""
    service = service_user(config)
    tables = products(config)
    table = next((t for t in tables if str(t.get("team", "")).upper() == team.upper()), None)
    if table is None:
        teams = ", ".join(str(t.get("team", "?")) for t in tables)
        raise Refused(f"{config} has no table for the team {team!r}: its teams are {teams}")
    user = table.get("agent_user")
    if user is None or user == service:
        raise Refused(f"{config}: the table of team {team} names no agent_user of its own: set agent_user = \"NAME\" there, "
                      f"a user other than [service] user {service!r}, which the orchestrator runs as")
    if not isinstance(user, str) or not USER_RULE.fullmatch(user):
        raise Refused(f"{config}: the agent_user {user!r} of team {team} is not a user name of a lowercase letter, digits and dashes")
    repo = table.get("repo")
    if not isinstance(repo, str) or "/" not in repo:
        raise Refused(f"{config}: team {team} names no repository (OWNER/NAME)")
    port = table.get("paseo_port")
    if port is not None and (not isinstance(port, int) or not 1024 <= port <= 65535):
        raise Refused(f"{config}: the paseo_port of team {team} must be a whole number from 1024 to 65535")
    args = ["--team", str(table["team"]), "--repo", repo, *(["--paseo-port", str(port)] if port else []),
            "--orchestrator-user", service]
    return user, args


def admin_command(args: Sequence[str]) -> list[str]:
    if args[:1] == ["--project"]:
        if len(args) < 2:
            raise Refused("owlcode admin --project TEAM: name the team")
        user, extra = project_args(CONFIG, args[1])
        return ["sudo", f"AGENT_USER={user}", PYTHON, "-I", LAUNCHER, AGENT_USER, "--", "admin", *extra, *args[2:]]
    return ["sudo", f"AGENT_USER={service_user(CONFIG)}", PYTHON, "-I", LAUNCHER, AGENT_USER, "--", "admin", *args]


def models_check_command(args: Sequence[str]) -> list[str]:
    """Not through the launcher: agent_user.py refuses every account but the agents' user, which cannot write root's record of a yes."""
    return [PYTHON, "-I", AGENT_USER, "models-check", *args]


# name: (words for the list, description, the command's argv from the arguments)
COMMANDS: Mapping[str, tuple[str, str, Callable[[Sequence[str]], list[str]]]] = {
    "install": ("install", "install the orchestrator as a service: the commits, a dry round of each side by side, then a yes (sudo)",
                install_command("")),
    "check": ("check", "check the service: the keys, Linear and GitHub, a recent round, long sessions, an old install, and the install's "
               "own properties (sudo); exit 1 on a FAIL", install_command("check")),
    "restart": ("restart", "restart the service after an edit of its config: one dry round on the config first, then the restart, "
                "then the check (sudo)", install_command("restart")),
    "set": ("set KEY=VALUE...", "change top-level keys of the config (owlcode set inference_profile=claude): the diff, the preflight "
            "and one dry round on a copy, then the write and the restart (sudo)", install_command("set")),
    "profile": ("profile [NAME]", "list the inference profiles and switch to the one you pick by number or by name: the same checks "
                "and restart as set (sudo)", install_command("profile")),
    "pause": ("pause", "hold the new starts and fix escalations until owlcode resume; wakes, closes and the queue go on (sudo)",
              install_command("pause")),
    "resume": ("resume", "end the pause: the service starts again in its next round (sudo)", install_command("resume")),
    "unlock": ("unlock", "unlock the agents' keychain in the service's own session, once after each restart of the Mac (sudo, then "
               "the keychain's password)", install_command("unlock")),
    "models": ("models", "show the inference catalog's valid combinations and token prices", agent_command("models")),
    "models-check": ("models-check", "compare catalog IDs with the providers' model lists, as the agents' user", models_check_command),
    "admin": ("admin [--project TEAM]", "make the agents' group, user and home, and copy agent_user.py there; the user is [service] "
              "user of the config, or with --project the agent_user of that team's table, with its clone and Paseo port (sudo)",
              admin_command),
}


def help_text() -> str:
    width = max(len(words) for words, _, _ in COMMANDS.values()) + 2
    lines = [f"owlcode {words.ljust(width)}{what}" for words, what, _ in COMMANDS.values()]
    return "usage: owlcode COMMAND [ARGUMENT ...]\n\n" + "\n".join(lines)


def argv_for(args: Sequence[str]) -> list[str]:
    """The command's argv for `owlcode ARGS`; Refused for a command that cannot run."""
    if not args or args[0] in ("help", "-h", "--help"):
        raise Refused(help_text())
    entry = COMMANDS.get(args[0])
    if entry is None:
        raise Refused(f"owlcode: unknown command {args[0]!r}\n\n{help_text()}")
    return entry[2](args[1:])


def main(args: Sequence[str]) -> int:
    if not args or args[0] in ("help", "-h", "--help"):
        print(help_text())
        return 0
    try:
        argv = argv_for(args)
    except Refused as e:
        print(e, file=sys.stderr)
        return 2
    os.chdir(REPO)
    os.execvp(argv[0], argv)
    return 1  # not reached: execvp replaces the process


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
